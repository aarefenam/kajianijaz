# Sistem
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Kredensial — JANGAN pernah masuk repo, apalagi repo publik.
# Simpan kunci Supabase/API di sini secara lokal saja; untuk deploy
# gunakan GitHub Secrets (lihat DEPLOY.md).
.env
.env.*
!.env.example

# Setelan alat bantu lokal. Di mesin ini ia sudah tertutup gitignore
# global, tetapi itu tidak ikut saat repo dikloning orang lain —
# jadi dikunci di sini agar perlindungannya terbawa proyek.
.claude/

# Dependensi (prototipe ini tidak memerlukannya, jaga-jaga saja)
node_modules/

# Dokumen sumber — sengaja TIDAK diunggah ke repo publik.
# Ini berkas internal yang Anda berikan; keputusan menerbitkannya
# ke internet ada di tangan pengurus, bukan otomatis.
# Hapus baris di bawah bila memang ingin ikut dipublikasikan.
*.pdf
data/
api/config.php
berkas/*
!berkas/.gitkeep
